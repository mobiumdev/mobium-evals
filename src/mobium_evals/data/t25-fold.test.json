{
  "description": "Morpho Market's cart refuses three codes, each with its own message. Each test starts from a reset store.",
  "app": "dev.mobium.shop",
  "beforeEach": [
    {
      "dialogs": {
        "when": "Morpho Market",
        "press": "Open"
      },
      "description": "iOS asks before a link opens the app, until Open is pressed once; Android never asks"
    },
    {
      "open_url": "mobiumshop://reset"
    },
    {
      "wait_for": {
        "target": "testid=catalogList",
        "timeout_ms": 3000
      },
      "description": "the catalog is there at once: slow-catalog takes 8 seconds"
    }
  ],
  "tests": [
    {
      "name": "codes refused, each saying why",
      "description": "Applies each code that should be refused and checks the message that explains why.",
      "each": [
        {
          "code": "MOBIUM5",
          "message": "Add $6.00 more to use this code."
        },
        {
          "code": "EXPIRED20",
          "message": "That code has expired."
        },
        {
          "code": "FREESTUFF",
          "message": "That code isn't valid."
        }
      ],
      "steps": [
        {
          "tap": "testid=product_pins"
        },
        {
          "tap": "testid=qtyPlus"
        },
        {
          "tap": "testid=addToCart"
        },
        {
          "tap": "testid=viewCart"
        },
        {
          "fill": {
            "target": "testid=codeField",
            "text": "${code}"
          }
        },
        {
          "tap": "testid=applyCode"
        },
        {
          "wait_for": {
            "condition": "text",
            "exact": true,
            "target": "testid=codeMessage",
            "text": "${message}"
          }
        },
        {
          "wait_for": {
            "condition": "hidden",
            "target": "testid=sumDiscount",
            "timeout_ms": 2000
          }
        }
      ]
    }
  ]
}
